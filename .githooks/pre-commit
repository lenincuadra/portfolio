#!/bin/sh
# Pre-commit: bloquea el commit si se rompe una invariante verificable del sitio.
# Chequeos (docs/a11y.md): contraste WCAG AA + lint estático de a11y.
# Setup (una vez por clone): git config core.hooksPath .githooks
# Nota: valida el working tree (lo que está en disco, no lo stageado).

root="$(git rev-parse --show-toplevel)"

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node no disponible, chequeos salteados (correrlos a mano — ver docs/a11y.md)." >&2
  exit 0
fi

fail=0

run_check() {
  # $1 = descripción, resto = comando
  desc="$1"; shift
  out="$("$@" 2>&1)" && return 0
  fail=1
  echo "" >&2
  echo "✗ Commit bloqueado: $desc" >&2
  echo "$out" | grep -E '✗|falla' >&2
}

run_check "contraste WCAG AA roto (docs/a11y.md)" \
  node "$root/scripts/a11y-contrast.js"
run_check "lint estático de a11y (tokens, --ink-4, invariantes de página, alt)" \
  node "$root/scripts/a11y-static.js"

[ "$fail" -eq 0 ] && exit 0
echo "Corregir y volver a commitear. Reglas: docs/a11y.md." >&2
exit 1
